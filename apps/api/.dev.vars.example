# Copy to .dev.vars for local Worker development. Never commit real secret values.
# Production secrets belong in Cloudflare Workers Secrets.

# Public project URL (safe to expose)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-only Supabase secret/service-role key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVER_SECRET

# Paddle webhook endpoint signing secret
PADDLE_WEBHOOK_SECRET=YOUR_PADDLE_WEBHOOK_SECRET

# Random signing material for internal cache/signing use
CACHE_SIGNING_KEY=GENERATE_A_RANDOM_32_BYTE_SECRET
