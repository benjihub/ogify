/**
 * Ogify API Worker configuration.
 *
 * Before deploying:
 * - create the CACHE KV namespace and paste real ids below
 * - create the optional RENDERS R2 bucket, or remove that binding if unused
 * - set secrets with `wrangler secret put ...`
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
 "name": "ogify-api",
"main": "src/index.ts",

"workers_dev": true,

"routes": [
  {
    "pattern": "api.ogify.online",
    "custom_domain": true
  }
],

"compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": false
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "a5de0a4d57724257baf8e8e835de9ec8"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "OGIFY_ENV": "production",
   "SUPABASE_URL": "https://fnrwytacoyeqczxeslku.supabase.co",

  "PADDLE_PRICE_STARTER_MONTHLY": "pri_01m411qcsmv83xqfnbrabggvad",
  "PADDLE_PRICE_STARTER_YEARLY": "pri_01m411xse7jn63t6m94ttdpjtw",

  "PADDLE_PRICE_PRO_MONTHLY": "pri_01m4123w968pwn85m8crja38q5",
  "PADDLE_PRICE_PRO_YEARLY": "pri_01m4127hte5t8bfbxjygkyfxsc",

  "PADDLE_PRICE_BUSINESS_MONTHLY": "pri_01m412gk9tzzt4d7avjwr73225",
  "PADDLE_PRICE_BUSINESS_YEARLY": "pri_01m412k47zvzbyetn3fwrhbk5w",

  "PADDLE_PRICE_LIFETIME": "pri_01m412dxjv72d6ac71gpdqnw1a"
  },
  "env": {
    "dev": {
      "name": "ogify-api-dev",
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "07cb2b71e95d498f9e71aaa4662a0a7d"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "vars": {
        "OGIFY_ENV": "development",
        "SUPABASE_URL": "https://fnrwytacoyeqczxeslku.supabase.co"
      }
    },
    "staging": {
      "name": "ogify-api-staging",
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "44c310ab68754c14b8f7b702304a0426"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "vars": {
        "OGIFY_ENV": "staging",
        "SUPABASE_URL": "https://fnrwytacoyeqczxeslku.supabase.co"
      }
    }
  }
}
